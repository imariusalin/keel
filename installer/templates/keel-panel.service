[Unit]
Description=Keel hosting panel
After=network.target

[Service]
Type=simple
User=keel
Group=keel
WorkingDirectory=/opt/keel
Environment=NODE_ENV=production
Environment=KEEL_APPLY=1
Environment=KEEL_VPS=1
Environment=KEEL_DATA_DIR=/var/lib/keel/pglite
Environment=KEEL_STATE=/var/lib/keel/state.json
Environment=PORT=9090
Environment=HOST=127.0.0.1
Environment=NITRO_PORT=9090
Environment=NITRO_HOST=127.0.0.1
Environment=KEEL_HOSTNAME=__HOSTNAME__
Environment=KEEL_PUBLIC_IP=__PUBLIC_IP__
ExecStart=/usr/bin/node /opt/keel/.output/server/index.mjs
Restart=on-failure
RestartSec=3
PrivateTmp=true

[Install]
WantedBy=multi-user.target
