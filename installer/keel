#!/bin/bash
# keel — operator CLI
set -euo pipefail
VERSION="$(cat /usr/local/share/keel/VERSION 2>/dev/null || echo 0.1.0)"

usage() {
  cat <<EOF
keel ${VERSION}
  apply [--dry-run]   write nginx, PHP-FPM, firewall, mail, DNS from panel state
  doctor              check nginx, PHP, disk, firewall
  status              panel + stack units
  fix                 put the panel on port 80 (disable welcome page, reload nginx)
  version
EOF
}

activate_http() {
  [ "$(id -u)" -eq 0 ] || { echo "root required" >&2; exit 1; }
  rm -f /etc/nginx/sites-enabled/default \
        /etc/nginx/sites-enabled/default.conf \
        /etc/nginx/conf.d/default.conf
  find /etc/nginx/sites-enabled -maxdepth 1 -name '*default*' -delete 2>/dev/null || true
  if [ ! -f /etc/nginx/sites-available/keel-panel.conf ]; then
    install -m 0644 /usr/local/share/keel/templates/nginx-panel.conf \
      /etc/nginx/sites-available/keel-panel.conf
  fi
  ln -sfn /etc/nginx/sites-available/keel-panel.conf /etc/nginx/sites-enabled/keel-panel.conf
  nginx -t
  systemctl restart keel-panel
  systemctl reload nginx || systemctl restart nginx
  echo "keel: panel is on port 80"
}

cmd="${1:-}"
case "$cmd" in
  apply)
    exec /usr/local/sbin/keel-apply "${2:-}"
    ;;
  version|-v|--version)
    echo "keel ${VERSION}"
    ;;
  fix)
    activate_http
    ;;
  status)
    systemctl is-active --quiet keel-panel && echo "panel: running" || echo "panel: down"
    systemctl is-active --quiet nginx && echo "nginx: running" || echo "nginx: down"
    ufw status | head -1 || true
    ;;
  doctor)
    echo "-- nginx"
    nginx -t
    if [ -e /etc/nginx/sites-enabled/default ]; then
      echo "WARN: distro default site still enabled — you will see Welcome to nginx"
    fi
    echo "-- panel"
    systemctl is-active keel-panel && echo "keel-panel: running" || echo "keel-panel: DOWN"
    curl -sf -o /dev/null -w "local_panel HTTP %{http_code}\n" "http://127.0.0.1:9090/" \
      || echo "local_panel: not answering on :9090"
    echo "-- php-fpm"
    for v in 8.1 8.2 8.3 8.4; do
      if systemctl list-unit-files "php${v}-fpm.service" >/dev/null 2>&1; then
        printf '  php%s-fpm %s\n' "$v" "$(systemctl is-active php${v}-fpm 2>/dev/null || echo missing)"
      fi
    done
    echo "-- disk"
    df -h / /var /home 2>/dev/null | awk 'NR==1 || /\/$|\/var|\/home/'
    echo "-- firewall"
    ufw status verbose | head -20
    echo "-- state"
    [ -f /var/lib/keel/state.json ] && jq '{hostname:.settings.hostname, sites:(.sites|length), apps:(.apps|length)}' /var/lib/keel/state.json
    ;;
  ""|-h|--help)
    usage
    ;;
  *)
    echo "unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
